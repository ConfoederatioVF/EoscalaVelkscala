{
    name: "Velkscala (Demographics)",
    synthetic_by_default: true,
    age_sex: {
        name: "Age/Sex",
        filepath: "${age_sex}/${gender}_${age}_${year}.png",
        type: "raster.age_sex", //This needs to be displayed as a population pyramid in tooltips/raster analysis somehow
        unit: "Total",
        synthetic_by_default: true,
        gender: {
            name: "Gender",
            f: {
                name: "Female",
                legend: {
                    colourscheme: "reds"
                }
            },
            m: {
                name: "Male",
                legend: {
                    colourscheme: "blues"
                }
            }
        },
        age: {
            name: "Age",
            "00": {
                name: "0-1yo"
            },
            "01": {
                name: "1-5yo"
            },
            "05": {
                name: "5-10yo"
            },
            "10": {
                name: "10-15yo"
            },
            "15": {
                name: "15-20yo"
            },
            "20": {
                name: "20-25yo"
            },
            "25": {
                name: "25-30yo"
            },
            "30": {
                name: "30-35yo"
            },
            "35": {
                name: "35-40yo"
            },
            "40": {
                name: "40-45yo"
            },
            "45": {
                name: "45-50yo"
            },
            "50": {
                name: "50-55yo"
            },
            "55": {
                name: "55-60yo"
            },
            "60": {
                name: "60-65yo"
            },
            "65": {
                name: "65-70yo"
            },
            "70": {
                name: "70-75yo"
            },
            "75": {
                name: "75-80yo"
            },
            "80": {
                name: "80+"
            }
        }
    },
    births: {
        name: "Births",
        filepath: "${vitals}/3.crude_births/births_${year}.png",
        unit: "Total",
        legend: {
            colourscheme: "prgn"
        }
    },
    deaths: {
        name: "Deaths",
        filepath: "${vitals}/3.${gender}_crude_deaths/${gender}_deaths_{year}.png",
        unit: "Total",
        variable_selectors: {
            gender: {
                name: "Gender",
                female: {
                    name: "Female",
                    legend: {
                        colourscheme: "prgn",
                        inverted: true
                    }
                },
                male: {
                    name: "Male",
                    legend: {
                        colourscheme: "rdgy",
                        inverted: true
                    }
                }
            }
        }
    },
    migration_gender: {
        name: "Migration (Gender)",
        filepath: "${vitals}/4.${gender}_net_migration/${gender}_net_migration_{year}.png",
        unit: "Total",
        variable_selectors: {
            gender: {
                name: "Gender",
                female: {
                    name: "Female",
                    legend: {
                        colourscheme: "rdgy",
                        inverted: true
                    }
                },
                male: {
                    name: "Male",
                    legend: {
                        colourscheme: "prgn",
                        inverted: true
                    }
                }
            }
        }
    },
    net_migration: {
        name: "Net Migration",
        filepath: "${vitals}/4.net_migration/net_migration_${year}.png",
        unit: "Total",
        legend: {
            colourscheme: "rdylgn"
        }
    },
    population_density: {
        name: "Population Density (ihb/km^2)",
        encoding: "float32",
        filepath: "${stad}/stadester_density_rasters/stadester_density_${year}.png",
        unit: "ihb/km^2",
        legend: {
            colourscheme: "reds"
        }
    },
    population_total: {
        name: "Population (Total)",
        encoding: "float32",
        filepath: "${stad}/stadester_population_rasters/stadester_population_${year}.png",
        /*pixel_offset: {
            covariate: "population_urban",
            y: 2
        },*/
        unit: "Total",
        legend: {
            colourscheme: "viridis"
        }
    },
    population_rural: {
        name: "Population (Rural)",
        encoding: "float32",
        filepath: "${stad}/stadester_rural_rasters/stadester_rural_{year}.png",
        unit: "Rural and periurban population, total",
        legend: {
            colourscheme: "greens"
        }
    },
    population_urban: {
        name: "Population (Urban)",
        encoding: "float32",
        filepath: "${stad}/stadester_urban_rasters/stadester_urban_{year}.png",
        unit: "Urban population, total",
        legend: {
            colourscheme: "blues"
        }
    }
}